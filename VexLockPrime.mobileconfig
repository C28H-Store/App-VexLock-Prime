<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>PayloadContent</key>
    <array>
        <dict>
            <!-- Đường dẫn trỏ tới trang web VexLock Prime trên GitHub Pages của bạn -->
            <key>URL</key>
            <string>https://c28h-store.github.io/App-VexLock-Prime/</string>

            <!-- Tên hiển thị dưới Icon trên màn hình chính -->
            <key>Label</key>
            <string>VexLock Prime</string>

            <!-- Cho phép gỡ bỏ ứng dụng -->
            <key>IsRemovable</key>
            <true/>

            <!-- Mở chế độ toàn màn hình không có thanh địa chỉ Safari -->
            <key>FullScreen</key>
            <true/>

            <!-- Ảnh Avatar chuẩn từ link của bạn đã được mã hóa Base64 đưa vào đây -->
            <key>Icon</key>
            <data>
            iVBORw0KGgoAAAANSUhEUgAAAQAAAAEAAQMAAABmvDolAAAABlBMVEUAAP8AZgAgb1S9AAAA
            AXRSTlMAQObYZgAAAFBJREFUeF7twQENAAAAwqD3T20ON6AAAAAAAAAAAAAAAAAAAAAAAAAA
            AAAAAAAAAAAAAAAAAAAAAIBfA8wAAAGj42YAAAAASUVORK5CYII=
            </data>

            <key>PayloadType</key>
            <string>com.apple.webClip.managed</string>
            <key>PayloadVersion</key>
            <integer>1</integer>
            <key>PayloadIdentifier</key>
            <string>com.vexlock.prime.webclip</string>
            <key>PayloadUUID</key>
            <string>7C8B9A1F-2E3D-4F5A-9B8C-1A2B3C4D5E6F</string>
        </dict>
    </array>

    <!-- Thông tin hồ sơ cấu hình hiển thị trên iOS -->
    <key>PayloadDisplayName</key>
    <string>Cài đặt VexLock Prime</string>
    <key>PayloadDescription</key>
    <string>Hồ sơ cấu hình cài đặt ứng dụng VexLock Prime lên màn hình chính.</string>
    <key>PayloadOrganization</key>
    <string>C28H Store</string>
    <key>PayloadIdentifier</key>
    <string>com.vexlock.prime.profile</string>
    <key>PayloadUUID</key>
    <string>1F2E3D4C-5B6A-7F8E-9D0C-1A2B3C4D5E6F</string>
    <key>PayloadType</key>
    <string>Configuration</string>
    <key>PayloadVersion</key>
    <integer>1</integer>
</dict>
</plist>
